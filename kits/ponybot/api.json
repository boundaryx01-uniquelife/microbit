    { "group": "거리 감지 센서", "block": "[센티미터] 단위로 측정한 거리", "js": "aiPonybot.ping(aiPonybot.PingUnit.Centimeters)", "range": "0~500 cm, 반사 없으면 500(최대값)을 돌려줌 — 0이 '못 읽음'이 아님" },
    { "group": "색상 감지 센서", "block": "컬러센서 초기화 : [검은색 모듈(V1)/보라색 모듈(V2)]", "js": "aiPonybot.initColorSensor(aiPonybot.SensorVersion.V1|V2)" },
    { "group": "색상 감지 센서", "block": "빨간색(R)/초록색(G)/파란색(B) 색상 값 읽기, 밝기(B) 값 읽기", "js": "aiPonybot.getRed()/getGreen()/getBlue()/getLight()" },
    { "group": "색상 감지 센서", "block": "감지된 색상이 [빨간색/초록색/파란색/노란색] (임계값 40)", "js": "aiPonybot.isColorAdvanced(aiPonybot.DetectedColor.Red, 40)" },
